---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
}

const { title, description, canonical, robots } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical} robots={robots}>
  <Navbar />
  <main id="main-content" class="flex-1 site-main">
    <slot />
  </main>
</Layout>

<script>
  // Tracking CTA delegato — copre tutte le pagine statiche senza idratare React.
  // L'evento è silenzioso finché non c'è consenso analytics (gestito in track()).
  import { initCtaTracking } from '../lib/ctaTracking';
  initCtaTracking();
</script>

<style is:global>
  /* Reserve space for fixed navbar */
  .site-main { padding-top: 76px; }
  /* Hero sections opt into bleeding under the glass nav: cancel main padding,
     re-add it inside the hero so its background extends to viewport top. */
  .site-main > section:first-child[data-hero-bleed] {
    margin-top: -76px;
    padding-top: 76px;
  }
  /* Print / Save-as-PDF: hide the fixed navbar and cancel its reserved space. */
  @media print {
    #floating-nav { display: none !important; }
    .site-main { padding-top: 0 !important; }
    .site-main > section:first-child[data-hero-bleed] {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
  }
</style>
