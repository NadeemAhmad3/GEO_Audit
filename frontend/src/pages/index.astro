---
import Shell from '../components/Shell.astro';
import AuditForm from '../components/AuditForm';
---

<Shell
  title="RankAI — Free GEO & AI Visibility Audit"
  description="Run a free GEO audit. See how ChatGPT, Perplexity, Claude and Gemini can crawl, understand and cite your site — and what to fix."
  canonical="https://geoready.dev/"
>
  {/* Hero */}
  <section
    id="audit-form"
    data-hero-bleed
    class="relative overflow-hidden"
    style="background: linear-gradient(180deg, #eff6ff 0%, #ecfeff 55%, #f0fdfa 100%);"
  >
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 78% 10%, rgba(56,189,248,0.20), transparent 42%), radial-gradient(circle at 10% 90%, rgba(13,148,136,0.10), transparent 42%);"
    />
    <div class="relative max-w-3xl mx-auto px-6 py-24 md:py-32 text-center">
      <p
        class="mb-5 inline-flex rounded-full px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em]"
        style="color:#0369a1; background:rgba(255,255,255,0.65); border:1px solid rgba(56,189,248,0.35); backdrop-filter:blur(6px);"
      >
        AI visibility audit
      </p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight" style="color:#0f172a;">
        Is your website visible to
        <span style="background: linear-gradient(90deg, #0D9488, #06B6D4, #38BDF8); -webkit-background-clip:text; background-clip:text; color:transparent;"> AI search engines</span>?
      </h1>
      <p class="mt-6 text-lg md:text-xl leading-relaxed" style="color:#475569;">
        RankAI audits whether your site can be crawled, understood, and cited by AI answer
        engines like ChatGPT, Perplexity, Claude, and Gemini. Get a 0–100 GEO score across
        8 signal categories — free, no account required.
      </p>

      <div class="mt-10">
        <AuditForm client:load />
      </div>
    </div>
  </section>
</Shell>
